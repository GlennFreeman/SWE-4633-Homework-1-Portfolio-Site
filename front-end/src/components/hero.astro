---
import { Image } from "astro:assets";
import HeroImage from "../images/hero.webp";
import ProfilePicture from "../images/profile_picture.png";
---

<div class="hero min-h-fit">
  <Image src={HeroImage} alt="Hero Image" class="object-fill w-full" />
  <div
    class="glass hero-content text-neutral-content text-center lg:rounded-4xl sm:rounded-none"
  >
    <div class="max-w-fit">
      <h2 class="mt-5 text-5xl font-bold text-shadow-md">ATLANTA, GA</h2>
      <h3 class="mb-3 text-gray-300 font-light text-shadow-md">
        <a href="mailto:glenn.freeman.business@gmail.com"
          >GLENN.FREEMAN.BUSINESS@GMAIL.COM</a
        >
      </h3>
      <h1 class="mb-7 text-9xl font-bold text-shadow-md">Glenn Freeman</h1>
      <Image
        src={ProfilePicture}
        alt="Profile picture of Glenn Freeman"
        class="aura aura-silver w-48 h-48 mx-auto mb-5 rounded-full object-center object-scale-down aspect-square"
      />
      <p class="mb-5 text-5xl text-shadow-md">Artist, Developer, & Designer</p>
    </div>
  </div>
</div>
<style>
  /* redoing the glass style to include the saturate filter and to adjust the values of blur and opacity */
  .glass {
    --glass-blur: 7.5px;
    --glass-opacity: 50%;
    border: none;
    backdrop-filter: blur(var(--glass-blur, 40px)) saturate(250%);
    background-color: #0000;
    background-image:
      linear-gradient(
        135deg,
        oklch(100% 0 0 / var(--glass-opacity, 30%)) 0%,
        oklch(0% 0 0 / 0%) 100%
      ),
      linear-gradient(
        var(--glass-reflect-degree, 100deg),
        oklch(100% 0 0 / var(--glass-reflect-opacity, 5%)) 25%,
        oklch(0% 0 0 / 0%) 25%
      );
    box-shadow:
      0 0 0 1px oklch(100% 0 0 / var(--glass-border-opacity, 20%)) inset,
      0 0 0 2px oklch(0% 0 0 / 5%);
    text-shadow: 0 1px oklch(0% 0 0 / var(--glass-text-shadow-opacity, 5%));
  }
</style>
